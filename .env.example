# Compose interpolation ONLY. Local development placeholders, never production.
# Existing service/<name>/.env files override committed service .env.example files.
# If changing passwords, change the matching service DATABASE_URL too.
AUTH_DB_NAME=auth_db
AUTH_DB_USER=relay
AUTH_DB_PASSWORD=relay_dev_only
WORKFLOW_DB_NAME=workflow_db
WORKFLOW_DB_USER=relay
WORKFLOW_DB_PASSWORD=relay_dev_only
INTEGRATION_DB_NAME=integration_db
INTEGRATION_DB_USER=relay
INTEGRATION_DB_PASSWORD=relay_dev_only
ACTION_DB_NAME=action_db
ACTION_DB_USER=relay
ACTION_DB_PASSWORD=relay_dev_only
EXECUTION_DB_NAME=execution_db
EXECUTION_DB_USER=relay
EXECUTION_DB_PASSWORD=relay_dev_only
RAG_DB_NAME=rag_db
RAG_DB_USER=relay
RAG_DB_PASSWORD=relay_dev_only
RELAY_IMAGE_REGISTRY=relay
RELAY_IMAGE_TAG=dev
FRONTEND_URL=http://localhost:3000
API_GATEWAY_BIND_IP=127.0.0.1
API_GATEWAY_PORT=8001
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_PORT=3000
INTEGRATION_WORKER_CONCURRENCY=1
RAG_WORKER_CONCURRENCY=1

# Required: inspect existing Kafka storage before changing/recreating its container.
KAFKA_LOG_DIRS=/var/lib/kafka/data
