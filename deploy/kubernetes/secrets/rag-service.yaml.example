apiVersion: v1
kind: Secret
metadata:
  name: relay-rag-service
  namespace: relay
type: Opaque
stringData:
  DATABASE_URL: postgresql+asyncpg://RAG_USER:URL_ENCODED_PASSWORD@relay-infra.example.internal:5438/RAG_DATABASE
  # Matches the supplied Compose Redis (no AUTH), on an isolated private network only.
  # If your EXISTING Redis requires AUTH, preserve it instead; URL-encode the password:
  # CELERY_BROKER_URL: redis://:URL_ENCODED_PASSWORD@relay-infra.example.internal:6379/0
  CELERY_BROKER_URL: redis://relay-infra.example.internal:6379/0
  SUPABASE_SECRET_KEY: REPLACE_WITH_EXISTING_SERVER_SECRET
  OPENAI_API_KEY: REPLACE_WITH_EXISTING_EMBEDDING_KEY
