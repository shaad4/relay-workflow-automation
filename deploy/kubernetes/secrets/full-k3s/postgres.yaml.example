# Repeat for auth, workflow, integration, action, execution and rag.
# create-secrets.py creates matching database and application Secret values offline.
apiVersion: v1
kind: Secret
metadata:
  name: auth-postgres
  namespace: relay
type: Opaque
stringData:
  POSTGRES_USER: auth_user
  POSTGRES_DB: auth_db
  POSTGRES_PASSWORD: REPLACE_WITH_FRESH_KUBERNETES_PASSWORD
---
apiVersion: v1
kind: Secret
metadata:
  name: kafka-kraft
  namespace: relay
type: Opaque
stringData:
  CLUSTER_ID: REPLACE_WITH_STABLE_KAFKA_UUID
