apiVersion: v1
kind: Secret
metadata:
  name: relay-auth-service
  namespace: relay
type: Opaque
stringData:
  DATABASE_URL: postgresql+asyncpg://AUTH_USER:URL_ENCODED_PASSWORD@relay-infra.example.internal:5434/AUTH_DATABASE
  SMTP_USERNAME: REPLACE_WITH_EXISTING_USERNAME
  SMTP_PASSWORD: REPLACE_WITH_EXISTING_PASSWORD
  GOOGLE_CLIENT_SECRET: REPLACE_IF_ENABLED
