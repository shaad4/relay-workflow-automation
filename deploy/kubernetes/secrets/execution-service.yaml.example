apiVersion: v1
kind: Secret
metadata:
  name: relay-execution-service
  namespace: relay
type: Opaque
stringData:
  DATABASE_URL: postgresql+asyncpg://EXECUTION_USER:URL_ENCODED_PASSWORD@relay-infra.example.internal:5437/EXECUTION_DATABASE
  AI_CREDENTIAL_ENCRYPTION_KEY: REPLACE_WITH_EXISTING_FERNET_KEY
