apiVersion: v1
kind: Secret
metadata:
  name: relay-integration-service
  namespace: relay
type: Opaque
stringData:
  DATABASE_URL: postgresql+asyncpg://INTEGRATION_USER:URL_ENCODED_PASSWORD@relay-infra.example.internal:5435/INTEGRATION_DATABASE
  # Matches the supplied Compose Redis (no AUTH), on an isolated private network only.
  # If your EXISTING Redis requires AUTH, preserve it instead; URL-encode the password:
  # CELERY_BROKER_URL: redis://:URL_ENCODED_PASSWORD@relay-infra.example.internal:6379/1
  CELERY_BROKER_URL: redis://relay-infra.example.internal:6379/1
