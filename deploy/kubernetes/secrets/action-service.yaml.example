apiVersion: v1
kind: Secret
metadata:
  name: relay-action-service
  namespace: relay
type: Opaque
stringData:
  DATABASE_URL: postgresql+asyncpg://ACTION_USER:URL_ENCODED_PASSWORD@relay-infra.example.internal:5436/ACTION_DATABASE
  ACTION_CREDENTIAL_ENCRYPTION_KEY: REPLACE_WITH_EXISTING_FERNET_KEY
  GOOGLE_CLIENT_SECRET: REPLACE_IF_ENABLED
