# Install manually into an existing Nginx HTTPS virtual host after DNS/cert review.
# No cert-manager, external proxy service or paid dependency is required.
# Replace hostnames/certificate paths. This file is NOT applied automatically.
map $http_upgrade $relay_connection_upgrade {
    default upgrade;
    '' close;
}
# Empty keys skip the limiter. The public edge owns the socket peer address.
map $uri $relay_auth_ip {
    default "";
    ~^/(?:api/relay/)?auth/(?:login|register|forgot-password|reset-password|resend-verification)/?$ $binary_remote_addr;
}
map $uri $relay_hook_ip {
    default "";
    ~^/(?:api/relay/)?hooks/ $binary_remote_addr;
}
map $relay_auth_ip $relay_edge_retry {
    "" 1;
    default 6;
}
limit_req_zone $relay_auth_ip zone=relay_auth:1m rate=10r/m;
limit_req_zone $relay_hook_ip zone=relay_hooks:4m rate=120r/m;
server {
    listen 80;
    server_name relay.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name relay.example.com;
    ssl_certificate /etc/letsencrypt/live/relay.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/relay.example.com/privkey.pem;
    # Match the application upload policy, not an unlimited body size.
    client_max_body_size 25m;
    limit_req zone=relay_auth burst=9 nodelay;
    limit_req zone=relay_hooks burst=119 nodelay;
    limit_req_status 429;
    error_page 429 = @relay_rate_limited;
    location @relay_rate_limited {
        default_type application/json;
        add_header Retry-After $relay_edge_retry always;
        return 429 '{"detail":"Too many requests"}';
    }
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $relay_connection_upgrade;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }
}
# Optional dedicated API domain: proxy to 127.0.0.1:8001 using matching headers.
# Browser auth is safest using the same-origin frontend /api/relay route; when
# splitting domains, separately review COOKIE_SAMESITE, CORS, CSRF and OAuth URLs.
