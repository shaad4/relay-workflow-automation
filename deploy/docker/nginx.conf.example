# Install manually into an existing Nginx HTTPS virtual host after DNS/cert review.
# No cert-manager, external proxy service or paid dependency is required.
# Replace hostnames/certificate paths. This file is NOT applied automatically.
map $http_upgrade $relay_connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 80;
    server_name relay.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name relay.example.com;
    ssl_certificate /etc/letsencrypt/live/relay.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/relay.example.com/privkey.pem;
    # Match the application upload policy, not an unlimited body size.
    client_max_body_size 25m;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $relay_connection_upgrade;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }
}
# Optional dedicated API domain: proxy to 127.0.0.1:8001 using matching headers.
# Browser auth is safest using the same-origin frontend /api/relay route; when
# splitting domains, separately review COOKIE_SAMESITE, CORS, CSRF and OAuth URLs.
