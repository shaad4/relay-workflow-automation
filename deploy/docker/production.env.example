# COPY OUTSIDE THE CHECKOUT to a mode-0600 operator-owned .env file.
# Existing database passwords, JWT keys and encryption keys must be preserved.
# These placeholders deliberately do not start a production deployment.
RELAY_IMAGE_REGISTRY=ghcr.io/your-owner/relay
RELAY_IMAGE_TAG=replace-with-reviewed-commit-sha
RELAY_ENV_DIR=/etc/relay/env
FRONTEND_URL=https://relay.example.com
BACKEND_URL=https://relay.example.com/api/relay
AUTH_DB_NAME=auth_db
AUTH_DB_USER=relay
AUTH_DB_PASSWORD=replace-with-existing-secret
WORKFLOW_DB_NAME=workflow_db
WORKFLOW_DB_USER=relay
WORKFLOW_DB_PASSWORD=replace-with-existing-secret
INTEGRATION_DB_NAME=integration_db
INTEGRATION_DB_USER=relay
INTEGRATION_DB_PASSWORD=replace-with-existing-secret
ACTION_DB_NAME=action_db
ACTION_DB_USER=relay
ACTION_DB_PASSWORD=replace-with-existing-secret
EXECUTION_DB_NAME=execution_db
EXECUTION_DB_USER=relay
EXECUTION_DB_PASSWORD=replace-with-existing-secret
RAG_DB_NAME=rag_db
RAG_DB_USER=relay
RAG_DB_PASSWORD=replace-with-existing-secret
INTEGRATION_WORKER_CONCURRENCY=1
RAG_WORKER_CONCURRENCY=1
EXECUTION_MAX_CONCURRENCY=1
# Hybrid only: VM private interface + DNS resolving to that address from pods.
# Configure private ingress restrictions BEFORE publishing these ports.
# RELAY_PRIVATE_BIND_IP=10.0.0.10
# KAFKA_PRIVATE_HOST=relay-infra.internal.example

# Required: inspect existing Kafka storage before changing/recreating its container.
KAFKA_LOG_DIRS=/var/lib/kafka/data
