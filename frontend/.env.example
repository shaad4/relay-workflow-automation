# Server-only runtime configuration. Never put credentials in NEXT_PUBLIC_*.
# Local Next dev server -> Compose gateway; containers use http://api-gateway:8000.
API_GATEWAY_URL=http://127.0.0.1:8001
FRONTEND_URL=http://localhost:3000
API_PROXY_TIMEOUT_SECONDS=120
# 12 MiB covers the RAG service's 10 MiB file limit plus multipart overhead.
API_PROXY_MAX_BODY_BYTES=12582912
# Legacy build-time direct-API mode, optional; omit for reusable same-origin images.
# NEXT_PUBLIC_AUTH_API_URL=http://localhost:8001
