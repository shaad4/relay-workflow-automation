# Development only. Preserve existing production credentials; never rotate keys at deploy.
RELAY_ENV=development
# Required, service-owned PostgreSQL database. URL-encode passwords in URLs.
DATABASE_URL=postgresql+asyncpg://relay:relay_dev_only@execution-postgres:5432/execution_db
# Optional connection pool bounds; integration Celery workers retain NullPool.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Internal gRPC bind (never publish publicly).
GRPC_BIND_ADDRESS=[::]:50055
AUTH_GRPC_URL=auth-service:50051
WORKFLOW_GRPC_URL=workflow-service:50052
ACTION_GRPC_URL=action-service:50054
# Optional override; omitted so an existing RAG_GRPC_ADDRESS still wins.
# RAG_GRPC_URL=rag-service:50056

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Keep the existing group when upgrading to avoid replaying old Kafka events.
KAFKA_CONSUMER_GROUP_ID=execution-service
# One application process/replica initially; do not scale without recovery review.
EXECUTION_MAX_CONCURRENCY=5
MAX_CONCURRENT_AI_REQUESTS=10
AI_REQUEST_TIMEOUT_SECONDS=60
# Existing Fernet key for BYOK OpenAI/Gemini/Claude credentials. Required in production.
AI_CREDENTIAL_ENCRYPTION_KEY=
# Legacy RAG_GRPC_ADDRESS is still accepted when RAG_GRPC_URL is absent.
