# Development only. Preserve existing production credentials; never rotate keys at deploy.
RELAY_ENV=development
# Required, service-owned PostgreSQL database. URL-encode passwords in URLs.
DATABASE_URL=postgresql+asyncpg://relay:relay_dev_only@rag-postgres:5432/rag_db
# Optional connection pool bounds; integration Celery workers retain NullPool.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Internal gRPC bind (never publish publicly).
GRPC_BIND_ADDRESS=[::]:50056
# Optional override; omitted so an existing AUTH_GRPC_TARGET still wins.
# AUTH_GRPC_URL=auth-service:50051

CELERY_BROKER_URL=redis://rag-redis:6379/0
# Existing RAG upload/ingestion dependencies, validated when used (no API calls at startup).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Existing vectors require 1536-dimensional embeddings; do not change models casually.
# Legacy AUTH_GRPC_TARGET is still accepted when AUTH_GRPC_URL is absent.
