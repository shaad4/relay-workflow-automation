# Development only. Preserve existing production credentials; never rotate keys at deploy.
RELAY_ENV=development
# Required, service-owned PostgreSQL database. URL-encode passwords in URLs.
DATABASE_URL=postgresql+asyncpg://relay:relay_dev_only@action-postgres:5432/action_db
# Optional connection pool bounds; integration Celery workers retain NullPool.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Internal gRPC bind (never publish publicly).
GRPC_BIND_ADDRESS=[::]:50054
AUTH_GRPC_URL=auth-service:50051

# Existing Fernet key for stored integration credentials. Required in production.
ACTION_CREDENTIAL_ENCRYPTION_KEY=
MAX_CONCURRENT_HTTP_REQUESTS=10
# Optional Gmail OAuth. Configure exact callback in the provider console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3000/api/relay/connections/gmail/oauth/callback
