# Development only. Preserve existing production credentials; never rotate keys at deploy.
RELAY_ENV=development
# Required, service-owned PostgreSQL database. URL-encode passwords in URLs.
DATABASE_URL=postgresql+asyncpg://relay:relay_dev_only@auth-postgres:5432/auth_db
# Optional connection pool bounds; integration Celery workers retain NullPool.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
# Public browser origin, not Docker/Kubernetes service DNS. Production requires HTTPS.
FRONTEND_URL=http://localhost:3000
# Optional extra explicit browser origins, comma-separated. Never use wildcard.
CORS_ALLOWED_ORIGINS=
# Shared EXACTLY between auth-service and api-gateway. Replace for production.
JWT_SECRET_KEY=relay-development-only-jwt-secret-do-not-use-in-production
JWT_ALGORITHM=HS256

# Internal gRPC bind (never publish publicly).
GRPC_BIND_ADDRESS=[::]:50051

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
VERIFICATION_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# Set true behind HTTPS; required true in production. SameSite=None also requires true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Public API prefix used in email links; same-origin frontend proxy is the default.
BACKEND_URL=http://localhost:3000/api/relay
# Required for email verification/reset delivery; not needed just to start the API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Relay
# Optional Google sign-in credentials. Configure the exact callback with Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/relay/auth/google/callback
